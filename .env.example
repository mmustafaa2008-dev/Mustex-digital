# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (e.g. Mustex Digitals <hello@yourdomain.com>)
FROM_EMAIL=Mustex Digitals <onboarding@resend.dev>

# Inbox that receives project inquiries
TO_EMAIL=mustexdigitals@gmail.com

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx

# Service role key — server-only, NEVER expose to the client or commit it.
# Used exclusively in Server Actions (lib/supabase/server.ts) to write to
# project_inquiries / newsletter_subscribers, which have RLS enabled with
# no public policies.
